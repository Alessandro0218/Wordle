{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "⚙️backend",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "backend.app:app",
                "--host", "0.0.0.0",
                "--reload"
            ],
            "cwd": "${workspaceFolder}",
            "jinja": true
        },
        {
            "name": "🚀frontend",
            "type": "chrome",
            "request": "launch",
            "url": "http://192.168.0.2:4200",
            "webRoot": "${workspaceFolder}/frontend/wordui",
            "preLaunchTask": "angular-start",
            "postDebugTask": "angular-stop",
        }
    ],
    "compounds": [
        {
            "name": "🧪 All: frontend + backend",
            "configurations": [
                "⚙️backend",
                "🚀frontend"
            ]
        }
    ]
}